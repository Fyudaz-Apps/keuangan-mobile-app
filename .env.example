# Application Settings
APP_NAME=keuangan-mobile-app
APP_VERSION=1.0.0
ENVIRONMENT=development

# API Configuration
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# Database Configuration
REALM_SCHEMA_VERSION=1
DATABASE_NAME=keuangan.realm

# User Preferences
DEFAULT_CURRENCY=IDR
DEFAULT_LANGUAGE=id
DEFAULT_THEME=light

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true

# Logging
LOG_LEVEL=debug
ENABLE_LOGS=true

# Gemini AI Configuration
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 9router AI Configuration
EXPO_PUBLIC_9ROUTER_URL=http://localhost:20128/v1
EXPO_PUBLIC_9ROUTER_API_KEY=sk-0627a1b2f2057aca-b14fsh-43cb71d9
EXPO_PUBLIC_9ROUTER_MODEL=gpt-4o-mini

